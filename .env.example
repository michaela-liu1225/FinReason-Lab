# Optional packaged FinQA dataset used by example-id API requests.
FINREASON_DATASET_PATH=raw_data/finqa/dev.json

# OpenAI-compatible model endpoint used only by /v1/reason. This hostname lets
# the Compose container reach a server running on the Docker host (macOS/Windows).
FINREASON_MODEL_BASE_URL=http://host.docker.internal:8001/v1
FINREASON_MODEL_NAME=Qwen/Qwen3-4B
FINREASON_MODEL_API_KEY=local-token
FINREASON_MODEL_TIMEOUT=60

# Optional local retrieval models. Leave unset for dependency-free BM25.
# FINREASON_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# FINREASON_EMBEDDING_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41
# FINREASON_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
# FINREASON_RERANKER_REVISION=233902d25c440f23af6f7d6e94d2946bac0bee0a
# FINREASON_DOCKER_EXTRAS=api,semantic
