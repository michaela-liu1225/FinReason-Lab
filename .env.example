# Optional packaged FinQA dataset used by example-id API requests.
FINREASON_DATASET_PATH=raw_data/finqa/dev.json

# OpenAI-compatible model endpoint used by /v1/reason and the fixed-model
# evaluator. This hostname lets the Compose container reach a server running on
# the Docker host (macOS/Windows).
FINREASON_MODEL_BASE_URL=http://host.docker.internal:8001/v1
FINREASON_MODEL_NAME=Qwen/Qwen3-4B
# Pin these identities before publishing an end-to-end benchmark. The adapter
# revision may be left empty when evaluating the base model.
FINREASON_MODEL_REVISION=1cfa9a7208912126459214e8b04321603b3df60c
FINREASON_TOKENIZER_REVISION=1cfa9a7208912126459214e8b04321603b3df60c
# FINREASON_ADAPTER_REVISION=<adapter-sha256-or-revision>
# FINREASON_CHAT_TEMPLATE_SHA256=<sha256>
FINREASON_MODEL_API_KEY=local-token
FINREASON_MODEL_TIMEOUT=60
FINREASON_MODEL_TEMPERATURE=0
FINREASON_MODEL_TOP_P=1
FINREASON_MODEL_MAX_TOKENS=512
FINREASON_MODEL_SEED=42
# Qwen3 request-level control; keep false for strict JSON program generation.
FINREASON_MODEL_ENABLE_THINKING=false

# Optional local retrieval models. Leave unset for dependency-free BM25.
# FINREASON_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# FINREASON_EMBEDDING_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41
# FINREASON_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
# FINREASON_RERANKER_REVISION=233902d25c440f23af6f7d6e94d2946bac0bee0a
# FINREASON_DOCKER_EXTRAS=api,semantic
